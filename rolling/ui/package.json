{
  "name": "midnight-rolling-walkthrough",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "artifacts": "node scripts/extract-artifacts.mjs",
    "dev": "pnpm run artifacts && vite",
    "build": "pnpm run artifacts && vite build",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm run artifacts && tsx src/verify.ts general && tsx src/verify.ts treasury && tsx src/verify.ts tranche && tsx src/verify.ts flash"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
